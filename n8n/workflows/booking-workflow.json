          "description": "=Customer: {{ $('Code: Validate & Normalize').first().json.customer_name }}\nPhone: {{ $('Code: Validate & Normalize').first().json.customer_phone }}\nService: {{ $('Code: Validate & Normalize').first().json.service_type }}\nCall ID: {{ $('Code: Validate & Normalize').first().json.call_id }}\nNotes: {{ $('Code: Validate & Normalize').first().json.notes }}",
          "reminders": {
            "useDefault": false,
            "overrides": [{ "method": "popup", "minutes": 30 }]
          }
        }
      },
