{
  "name": "VoxDesk — Booking Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "book-appointment",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook: Book Appointment",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "jsCode": "// ── VoxDesk: Validate & Normalize Booking Payload ─────────────────────────\nconst body = $input.first().json.body || $input.first().json;\n\n// Required fields\nconst required = ['customer_name', 'customer_phone', 'service_type', 'requested_date', 'requested_time'];\nfor (const field of required) {\n  if (!body[field]) {\n    throw new Error(`VALIDATION_ERROR: Missing required field: ${field}`);\n  }\n}\n\n// Service duration map (minutes)\nconst durations = {\n  'haircut': 45,\n  'hair coloring': 90,\n  'massage': 60,\n  'facial': 60,\n  'consultation': 30,\n  'default': 60\n};\n\nconst serviceKey = body.service_type.toLowerCase();\nconst durationMins = durations[serviceKey] || durations['default'];\n\n// Parse start datetime\n// requested_date: YYYY-MM-DD, requested_time: HH:MM (24h)\nconst [year, month, day] = body.requested_date.split('-').map(Number);\nconst [hour, minute] = body.requested_time.split(':').map(Number);\n\nconst startDate = new Date(year, month - 1, day, hour, minute);\n\n// Validate business hours (9 AM – 6 PM)\nif (hour < 9 || hour >= 18) {\n  throw new Error('VALIDATION_ERROR: Appointment must be within business hours (9 AM – 6 PM)');\n}\n\n// Validate not in the past\nif (startDate < new Date()) {\n  throw new Error('VALIDATION_ERROR: Cannot book an appointment in the past');\n}\n\n// Calculate end time\nconst endDate = new Date(startDate.getTime() + durationMins * 60 * 1000);\n\nreturn [{\n  json: {\n    customer_name: body.customer_name.trim(),\n    customer_phone: body.customer_phone.trim(),\n    service_type: body.service_type.trim(),\n    notes: body.notes || '',\n    call_id: body.call_id || '',\n    start_iso: startDate.toISOString(),\n    end_iso: endDate.toISOString(),\n    duration_mins: durationMins,\n    time_min: startDate.toISOString(),\n    time_max: endDate.toISOString()\n  }\n}];"
      },
      "id": "validate-payload",
      "name": "Code: Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "event",
        "operation": "getAll",
        "calendarId": "={{ $env.GOOGLE_CALENDAR_ID }}",
        "timeMin": "={{ $json.time_min }}",
        "timeMax": "={{ $json.time_max }}",
        "singleEvents": true,
        "returnAll": true
      },
      "id": "calendar-check",
      "name": "Google Calendar: Check Slot",
