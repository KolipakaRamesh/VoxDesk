{
  "name": "VoxDesk — Error Handler Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// ── VoxDesk: Parse workflow error and determine response ──────────────────\nconst errorData = $input.first().json;\n\nconst workflowName = errorData.workflow?.name || 'Unknown Workflow';\nconst errorMessage = errorData.execution?.error?.message || 'Unknown error';\nconst nodeWhereFailed = errorData.execution?.lastNodeExecuted || 'Unknown node';\n\n// Detect validation errors thrown intentionally\nconst isValidationError = errorMessage.startsWith('VALIDATION_ERROR:');\nconst cleanMessage = errorMessage.replace('VALIDATION_ERROR: ', '');\n\nconsole.log(`[VoxDesk Error Handler] Workflow: ${workflowName} | Node: ${nodeWhereFailed} | Error: ${errorMessage}`);\n\nreturn [{\n  json: {\n    workflow_name: workflowName,\n    node_failed: nodeWhereFailed,\n    raw_error: errorMessage,\n    is_validation_error: isValidationError,\n    clean_message: cleanMessage,\n    error_code: isValidationError ? 'VALIDATION_ERROR' : 'INTERNAL_ERROR'\n  }\n}];"
      },
      "id": "parse-error",
      "name": "Code: Parse Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "is-booking-workflow",
              "leftValue": "={{ $json.workflow_name }}",
              "rightValue": "VoxDesk — Booking Workflow",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-booking-workflow",
      "name": "IF: Booking Workflow?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"{{ $json.clean_message }}\",\n  \"error_code\": \"{{ $json.error_code }}\"\n}",
        "options": { "responseCode": 400 }
      },
      "id": "respond-booking-error",
      "name": "Respond: Booking Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"available\": false,\n  \"error\": \"{{ $json.clean_message }}\",\n  \"error_code\": \"{{ $json.error_code }}\"\n}",
        "options": { "responseCode": 400 }
      },
      "id": "respond-availability-error",
      "name": "Respond: Availability Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [[{ "node": "Code: Parse Error", "type": "main", "index": 0 }]]
    },
    "Code: Parse Error": {
      "main": [[{ "node": "IF: Booking Workflow?", "type": "main", "index": 0 }]]
    },
    "IF: Booking Workflow?": {
      "main": [
        [{ "node": "Respond: Booking Error", "type": "main", "index": 0 }],
        [{ "node": "Respond: Availability Error", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "voxdesk-mvp"
  },
  "id": "voxdesk-error-handler-v1",
  "tags": [{ "name": "voxdesk" }, { "name": "mvp" }]
}
