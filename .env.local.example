# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ─── Retell AI ────────────────────────────────────────────────────────────────
# Get these from: Retell AI Dashboard → API Keys
RETELL_API_KEY=key_...your-retell-api-key
RETELL_AGENT_ID=agent_...your-agent-id

# ─── Telephony (Vobiz) ────────────────────────────────────────────────────────
# Vobiz integration is configured directly in Retell AI Dashboard.
# No backend environment variables are required for Vobiz.

# ─── Google Calendar (Service Account) ────────────────────────────────────────
# Create at: Google Cloud Console → IAM & Admin → Service Accounts
# Share your Google Calendar with the service account email (Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=voxdesk@your-gcp-project.iam.gserviceaccount.com
# Paste the full private key from the downloaded JSON file
# Replace literal newlines with \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQ...\n-----END PRIVATE KEY-----\n"
# The email or ID of the calendar to use (share this cal with service account)
GOOGLE_CALENDAR_ID=primary

# ─── n8n ──────────────────────────────────────────────────────────────────────
# Your n8n webhook URLs (copy from n8n after creating workflows)
N8N_BOOKING_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/book-appointment
N8N_AVAILABILITY_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/check-availability
# Secret token sent in Authorization header to authenticate requests from Retell
N8N_WEBHOOK_SECRET=your-strong-secret-token-here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
